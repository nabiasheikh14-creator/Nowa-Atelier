# Public URL used for Open Graph metadata. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Single keeper. Phase 1 has no sign-up.
# In development, the password falls back to oak-gall and the session secret
# falls back to a local constant. Set both before any shared deployment.
OWNER_PASSWORD=oak-gall
SESSION_SECRET=replace-with-a-long-random-string
OWNER_ID=00000000-0000-4000-8000-000000000001

# Where borrow requests are mailed. Never shown to visitors.
OWNER_EMAIL=
RESEND_API_KEY=
RESEND_FROM="The Library <onboarding@resend.dev>"

# Leave these empty to use the local .data/library.json store.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
