# Public URL used for Open Graph metadata. No trailing path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres. On Vercel the Supabase integration sets these. Leave empty to run read-only.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Whoever signs up with this email takes over the founding room.
OWNER_EMAIL=

# Optional: email borrow requests to room owners.
RESEND_API_KEY=
RESEND_FROM="The Library <onboarding@resend.dev>"
